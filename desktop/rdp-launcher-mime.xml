<?xml version="1.0" encoding="UTF-8"?>
<!-- Teaches the desktop that *.rdp files are remote desktop connections
     (Ubuntu otherwise treats them as text/plain). Installed per user by
     `make install-desktop` into ~/.local/share/mime/packages/. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-rdp">
    <comment>Remote desktop connection</comment>
    <glob pattern="*.rdp"/>
    <glob pattern="*.RDP"/>
  </mime-type>
</mime-info>
